/* generated by scripts/make_themes.py - dark */
* { font-family: "Segoe UI", "Inter", "Noto Sans", "DejaVu Sans", sans-serif; font-size: 10pt; }
QWidget { background: #10141c; color: #e7ebf3; }
QMainWindow, QDialog { background: #10141c; }
QLabel { background: transparent; }
QToolTip { background: #283246; color: #e7ebf3; border: 1px solid #2c3648; padding: 4px 6px; }

#Sidebar { background: #0c1017; border: none; }
#Sidebar QLabel { background: transparent; color: #b4bfd4; }
#Sidebar #AppTitle { color: #ffffff; font-size: 12pt; font-weight: 700; padding: 0 4px; }
#Sidebar QPushButton { background: transparent; color: #b4bfd4; text-align: left; padding: 10px 14px;
    border: none; border-radius: 8px; font-size: 10.5pt; }
#Sidebar QPushButton:hover { background: #1c2638; color: #ffffff; }
#Sidebar QPushButton:checked { background: #5b93ff; color: #08111f; font-weight: 600; }
#Header { background: #171d28; border-bottom: 1px solid #2c3648; }
#Header QLineEdit { min-width: 340px; padding: 8px 12px; border-radius: 18px; }

QFrame#Card, QWidget#Card { background: #171d28; border: 1px solid #2c3648; border-radius: 10px; }
QFrame#Card QLabel, QWidget#Card QLabel { background: transparent; }
QFrame#KpiCard { background: #171d28; border: 1px solid #2c3648; border-radius: 10px; }
QFrame#KpiCard:hover { border-color: #5b93ff; background: #1f2735; }
QFrame#KpiCard QLabel { background: transparent; }
QLabel#KpiTitle { color: #8d99b1; font-size: 9pt; }
QLabel#KpiValue { font-size: 18pt; font-weight: 700; }
QLabel#KpiDelta { font-size: 9pt; color: #8d99b1; }
QLabel#KpiDelta[tone="good"] { color: #3ecf8e; }
QLabel#KpiDelta[tone="bad"] { color: #ff6b6b; }
QLabel#SectionTitle { font-size: 11pt; font-weight: 600; }
QLabel#PageTitle { font-size: 16pt; font-weight: 700; }
QLabel#Muted, QLabel[muted="true"] { color: #8d99b1; }
QLabel#Badge { padding: 2px 10px; border-radius: 10px; background: #283246; font-size: 9pt; font-weight: 600; }
QLabel#Badge[tone="ok"] { background: #123326; color: #3ecf8e; }
QLabel#Badge[tone="warn"] { background: #3a2d12; color: #f5b04c; }
QLabel#Badge[tone="bad"] { background: #3b1a1f; color: #ff6b6b; }
QLabel#Warning { background: #3a2d12; color: #f5b04c; border-radius: 6px; padding: 6px 10px; }
QLabel#Danger { background: #3b1a1f; color: #ff6b6b; border-radius: 6px; padding: 6px 10px; }
QLabel#EmptyTitle { font-size: 15pt; font-weight: 700; }

QPushButton { background: #1f2735; border: 1px solid #2c3648; border-radius: 7px; padding: 7px 14px; }
QPushButton:hover { background: #283246; }
QPushButton:pressed { background: #2c3648; }
QPushButton:disabled { color: #8d99b1; background: #171d28; }
QPushButton[kind="primary"] { background: #5b93ff; color: #08111f; border: 1px solid #5b93ff; font-weight: 600; }
QPushButton[kind="primary"]:hover { background: #78a6ff; }
QPushButton[kind="danger"] { color: #ff6b6b; }
QPushButton[kind="flat"] { background: transparent; border: none; color: #5b93ff; padding: 4px 8px; }
QPushButton[kind="flat"]:hover { background: #1f2735; }
QToolButton { background: transparent; border: none; padding: 6px; border-radius: 6px; }
QToolButton:hover { background: #283246; }

QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QDateEdit, QSpinBox, QDoubleSpinBox {
    background: #171d28; border: 1px solid #2c3648; border-radius: 7px; padding: 6px 8px;
    selection-background-color: #27406e; selection-color: #e7ebf3; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus {
    border: 1px solid #5b93ff; }
QLineEdit:disabled, QComboBox:disabled, QDateEdit:disabled { color: #8d99b1; background: #1f2735; }
QLineEdit[lowConfidence="true"], QComboBox[lowConfidence="true"], QDateEdit[lowConfidence="true"] {
    border: 1px solid #f5b04c; background: #3a2d12; }
QLineEdit[invalid="true"] { border: 1px solid #ff6b6b; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView { background: #171d28; border: 1px solid #2c3648; selection-background-color: #27406e; }
QCheckBox, QRadioButton { spacing: 8px; background: transparent; }
QCheckBox::indicator, QRadioButton::indicator { width: 16px; height: 16px; border: 1px solid #2c3648; border-radius: 4px;
    background: #171d28; }
QRadioButton::indicator { border-radius: 9px; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked { background: #5b93ff; border-color: #5b93ff; }

QTableView, QTreeView, QListView, QListWidget { background: #171d28; alternate-background-color: #1f2735;
    border: 1px solid #2c3648; border-radius: 8px; gridline-color: #2c3648;
    selection-background-color: #27406e; selection-color: #e7ebf3; outline: 0; }
QTableView::item, QTreeView::item { padding: 4px 6px; }
QListWidget::item { padding: 6px 8px; border-radius: 6px; }
QListWidget::item:hover { background: #1f2735; }
QHeaderView::section { background: #1f2735; color: #8d99b1; border: none; border-bottom: 1px solid #2c3648;
    padding: 7px 8px; font-weight: 600; }
QTableCornerButton::section { background: #1f2735; border: none; }
QScrollArea { border: none; background: transparent; }
QScrollBar:vertical { background: transparent; width: 11px; margin: 0; }
QScrollBar::handle:vertical { background: #283246; border-radius: 5px; min-height: 28px; }
QScrollBar::handle:vertical:hover { background: #8d99b1; }
QScrollBar:horizontal { background: transparent; height: 11px; margin: 0; }
QScrollBar::handle:horizontal { background: #283246; border-radius: 5px; min-width: 28px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }

QTabWidget::pane { border: 1px solid #2c3648; border-radius: 8px; top: -1px; background: #171d28; }
QTabBar::tab { background: transparent; padding: 8px 16px; margin-right: 2px; color: #8d99b1; border-bottom: 2px solid transparent; }
QTabBar::tab:selected { color: #e7ebf3; border-bottom: 2px solid #5b93ff; font-weight: 600; }
QTabBar::tab:hover { color: #e7ebf3; }
QGroupBox { border: 1px solid #2c3648; border-radius: 8px; margin-top: 14px; padding: 12px 8px 8px 8px; background: transparent; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 6px; color: #8d99b1; font-weight: 600; }
QSplitter::handle { background: #2c3648; }
QSplitter::handle:horizontal { width: 3px; }
QSplitter::handle:vertical { height: 3px; }
QMenu { background: #171d28; border: 1px solid #2c3648; padding: 4px; }
QMenu::item { padding: 7px 22px; border-radius: 5px; }
QMenu::item:selected { background: #27406e; }
QProgressBar { border: 1px solid #2c3648; border-radius: 6px; text-align: center; background: #1f2735; height: 16px; }
QProgressBar::chunk { background: #5b93ff; border-radius: 5px; }
QStatusBar { background: #171d28; border-top: 1px solid #2c3648; color: #8d99b1; }
QStatusBar QLabel { color: #8d99b1; }
QFrame#DropZone { border: 2px dashed #2c3648; border-radius: 10px; background: #171d28; }
QFrame#DropZone[active="true"] { border-color: #5b93ff; background: #1f2735; }
QFrame[frameShape="4"], QFrame[frameShape="5"] { color: #2c3648; }
