/* generated by scripts/make_themes.py - light */
* { font-family: "Segoe UI", "Inter", "Noto Sans", "DejaVu Sans", sans-serif; font-size: 10pt; }
QWidget { background: #f3f5f9; color: #1b2333; }
QMainWindow, QDialog { background: #f3f5f9; }
QLabel { background: transparent; }
QToolTip { background: #e2e7f1; color: #1b2333; border: 1px solid #d6dce9; padding: 4px 6px; }

#Sidebar { background: #1b2438; border: none; }
#Sidebar QLabel { background: transparent; color: #c4cde0; }
#Sidebar #AppTitle { color: #ffffff; font-size: 12pt; font-weight: 700; padding: 0 4px; }
#Sidebar QPushButton { background: transparent; color: #c4cde0; text-align: left; padding: 10px 14px;
    border: none; border-radius: 8px; font-size: 10.5pt; }
#Sidebar QPushButton:hover { background: #2b3a58; color: #ffffff; }
#Sidebar QPushButton:checked { background: #2563eb; color: #ffffff; font-weight: 600; }
#Header { background: #ffffff; border-bottom: 1px solid #d6dce9; }
#Header QLineEdit { min-width: 340px; padding: 8px 12px; border-radius: 18px; }

QFrame#Card, QWidget#Card { background: #ffffff; border: 1px solid #d6dce9; border-radius: 10px; }
QFrame#Card QLabel, QWidget#Card QLabel { background: transparent; }
QFrame#KpiCard { background: #ffffff; border: 1px solid #d6dce9; border-radius: 10px; }
QFrame#KpiCard:hover { border-color: #2563eb; background: #eef1f7; }
QFrame#KpiCard QLabel { background: transparent; }
QLabel#KpiTitle { color: #64708a; font-size: 9pt; }
QLabel#KpiValue { font-size: 18pt; font-weight: 700; }
QLabel#KpiDelta { font-size: 9pt; color: #64708a; }
QLabel#KpiDelta[tone="good"] { color: #15885a; }
QLabel#KpiDelta[tone="bad"] { color: #d33f49; }
QLabel#SectionTitle { font-size: 11pt; font-weight: 600; }
QLabel#PageTitle { font-size: 16pt; font-weight: 700; }
QLabel#Muted, QLabel[muted="true"] { color: #64708a; }
QLabel#Badge { padding: 2px 10px; border-radius: 10px; background: #e2e7f1; font-size: 9pt; font-weight: 600; }
QLabel#Badge[tone="ok"] { background: #dcf5ea; color: #15885a; }
QLabel#Badge[tone="warn"] { background: #fff1d6; color: #b86e00; }
QLabel#Badge[tone="bad"] { background: #fde4e6; color: #d33f49; }
QLabel#Warning { background: #fff1d6; color: #b86e00; border-radius: 6px; padding: 6px 10px; }
QLabel#Danger { background: #fde4e6; color: #d33f49; border-radius: 6px; padding: 6px 10px; }
QLabel#EmptyTitle { font-size: 15pt; font-weight: 700; }

QPushButton { background: #eef1f7; border: 1px solid #d6dce9; border-radius: 7px; padding: 7px 14px; }
QPushButton:hover { background: #e2e7f1; }
QPushButton:pressed { background: #d6dce9; }
QPushButton:disabled { color: #64708a; background: #ffffff; }
QPushButton[kind="primary"] { background: #2563eb; color: #ffffff; border: 1px solid #2563eb; font-weight: 600; }
QPushButton[kind="primary"]:hover { background: #1d4fd0; }
QPushButton[kind="danger"] { color: #d33f49; }
QPushButton[kind="flat"] { background: transparent; border: none; color: #2563eb; padding: 4px 8px; }
QPushButton[kind="flat"]:hover { background: #eef1f7; }
QToolButton { background: transparent; border: none; padding: 6px; border-radius: 6px; }
QToolButton:hover { background: #e2e7f1; }

QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QDateEdit, QSpinBox, QDoubleSpinBox {
    background: #ffffff; border: 1px solid #d6dce9; border-radius: 7px; padding: 6px 8px;
    selection-background-color: #cfe0ff; selection-color: #1b2333; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus {
    border: 1px solid #2563eb; }
QLineEdit:disabled, QComboBox:disabled, QDateEdit:disabled { color: #64708a; background: #eef1f7; }
QLineEdit[lowConfidence="true"], QComboBox[lowConfidence="true"], QDateEdit[lowConfidence="true"] {
    border: 1px solid #b86e00; background: #fff1d6; }
QLineEdit[invalid="true"] { border: 1px solid #d33f49; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView { background: #ffffff; border: 1px solid #d6dce9; selection-background-color: #cfe0ff; }
QCheckBox, QRadioButton { spacing: 8px; background: transparent; }
QCheckBox::indicator, QRadioButton::indicator { width: 16px; height: 16px; border: 1px solid #d6dce9; border-radius: 4px;
    background: #ffffff; }
QRadioButton::indicator { border-radius: 9px; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked { background: #2563eb; border-color: #2563eb; }

QTableView, QTreeView, QListView, QListWidget { background: #ffffff; alternate-background-color: #eef1f7;
    border: 1px solid #d6dce9; border-radius: 8px; gridline-color: #d6dce9;
    selection-background-color: #cfe0ff; selection-color: #1b2333; outline: 0; }
QTableView::item, QTreeView::item { padding: 4px 6px; }
QListWidget::item { padding: 6px 8px; border-radius: 6px; }
QListWidget::item:hover { background: #eef1f7; }
QHeaderView::section { background: #eef1f7; color: #64708a; border: none; border-bottom: 1px solid #d6dce9;
    padding: 7px 8px; font-weight: 600; }
QTableCornerButton::section { background: #eef1f7; border: none; }
QScrollArea { border: none; background: transparent; }
QScrollBar:vertical { background: transparent; width: 11px; margin: 0; }
QScrollBar::handle:vertical { background: #e2e7f1; border-radius: 5px; min-height: 28px; }
QScrollBar::handle:vertical:hover { background: #64708a; }
QScrollBar:horizontal { background: transparent; height: 11px; margin: 0; }
QScrollBar::handle:horizontal { background: #e2e7f1; border-radius: 5px; min-width: 28px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }

QTabWidget::pane { border: 1px solid #d6dce9; border-radius: 8px; top: -1px; background: #ffffff; }
QTabBar::tab { background: transparent; padding: 8px 16px; margin-right: 2px; color: #64708a; border-bottom: 2px solid transparent; }
QTabBar::tab:selected { color: #1b2333; border-bottom: 2px solid #2563eb; font-weight: 600; }
QTabBar::tab:hover { color: #1b2333; }
QGroupBox { border: 1px solid #d6dce9; border-radius: 8px; margin-top: 14px; padding: 12px 8px 8px 8px; background: transparent; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 6px; color: #64708a; font-weight: 600; }
QSplitter::handle { background: #d6dce9; }
QSplitter::handle:horizontal { width: 3px; }
QSplitter::handle:vertical { height: 3px; }
QMenu { background: #ffffff; border: 1px solid #d6dce9; padding: 4px; }
QMenu::item { padding: 7px 22px; border-radius: 5px; }
QMenu::item:selected { background: #cfe0ff; }
QProgressBar { border: 1px solid #d6dce9; border-radius: 6px; text-align: center; background: #eef1f7; height: 16px; }
QProgressBar::chunk { background: #2563eb; border-radius: 5px; }
QStatusBar { background: #ffffff; border-top: 1px solid #d6dce9; color: #64708a; }
QStatusBar QLabel { color: #64708a; }
QFrame#DropZone { border: 2px dashed #d6dce9; border-radius: 10px; background: #ffffff; }
QFrame#DropZone[active="true"] { border-color: #2563eb; background: #eef1f7; }
QFrame[frameShape="4"], QFrame[frameShape="5"] { color: #d6dce9; }
